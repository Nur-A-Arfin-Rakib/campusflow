# ═══════════════════════════════════════════════════════════════
#  CampusFlow — Production Environment Variables
#  Platform: Render.com OR Railway.app
#  Database: MongoDB Atlas
# ═══════════════════════════════════════════════════════════════
#
#  HOW TO USE:
#  Render  → Dashboard → Your Service → Environment → Add each key
#  Railway → Project → Variables → Add each key
#  (Never commit this file with real values!)
# ═══════════════════════════════════════════════════════════════

# ─── Server ──────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── MongoDB Atlas ───────────────────────────────────────────────
# Steps to get this:
#  1. Go to https://cloud.mongodb.com → create free cluster (M0)
#  2. Database Access → Add user (username + strong password)
#  3. Network Access → Add IP → Allow from anywhere (0.0.0.0/0)
#  4. Clusters → Connect → Connect your application → copy URI
#  5. Replace <username>, <password>, and <dbname>
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/campusflow?retryWrites=true&w=majority

# ─── JWT ─────────────────────────────────────────────────────────
# Generate a strong secret (run in terminal):
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING

# ─── CORS ────────────────────────────────────────────────────────
# Your frontend URL (after deploying client):
#   Render:  https://campusflow.onrender.com
#   Railway: https://campusflow.up.railway.app
CLIENT_URL=https://YOUR_FRONTEND_URL_HERE

# ─── Email (Gmail SMTP) ──────────────────────────────────────────
# Use Gmail App Password (NOT your main Gmail password)
# Setup: myaccount.google.com → Security → 2FA → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your16digitapppassword

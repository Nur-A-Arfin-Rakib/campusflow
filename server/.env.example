# ─── Server ─────────────────────────────────────────
PORT=5000
NODE_ENV=development        # change to 'production' on server

# ─── MongoDB ─────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/campusflow
# For MongoDB Atlas:
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/campusflow

# ─── JWT ─────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
# Access token expires in 15 minutes (do not change)
JWT_EXPIRES_IN=15m

# ─── CORS ────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
# Production: CLIENT_URL=https://yourdomain.com

# ─── Email (Gmail SMTP) ───────────────────────────────
# Setup steps:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Search "App passwords" → create one for "Mail"
# 4. Copy the 16-digit password below (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your16digitapppassword
